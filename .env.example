# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/patronaj?sslmode=require"

# 32-byte secret used for AES-256-GCM field encryption of JSHSHIR & clinical notes
ENCRYPTION_KEY="ovabmu-patronaj-aes256-hackathon-key-32b"

# Secret used to sign HTTP-only session cookies (falls back to ENCRYPTION_KEY if omitted)
AUTH_SECRET="ovabmu-patronaj-session-secret-key-2026"

# Google Gemini API key for conversational Sign-Up Assistant & Voice Intent Reasoning (Gemini 3.5 Flash)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# VoiceLab.uz API key (vlk_...) for Telegram Voice STT & Uzbek/Russian/English TTS replies (https://api.voicelab.uz)
VOICELAB_API_KEY=""
# Optional custom voice IDs (auto-selected via VoiceLab voices API if left blank)
VOICELAB_VOICE_ID_UZ=""
VOICELAB_VOICE_ID_RU=""
VOICELAB_VOICE_ID_EN=""

# Groq API key (https://console.groq.com) for fast free-tier Whisper STT (UZ/RU/EN) & LLM fallback
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3"
# Optional STT priority override: "auto" (VoiceLab -> Groq -> Gemini) | "groq" | "voicelab" | "gemini"
STT_PROVIDER="auto"

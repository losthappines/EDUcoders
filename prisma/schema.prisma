// Strict ACID-compliant relational schema for Avtomatlashtirilgan Patronaj Tizimi
// Configured for zero-config SQLite locally; swap provider to "postgresql" for production PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String    @default("")
  fullName              String
  role                  String    // OVABMU_MD | FAMILY_MD | PATIENT | ADMIN_RECEPTION
  verificationStatus    String    @default("VERIFIED") // PENDING | VERIFIED | REJECTED
  verificationNote      String?
  verifiedAt            DateTime?
  verifiedById          String?
  polyclinicId          String?
  polyclinicName        String?
  district              String?
  specialty             String?
  expertiseArea         String?
  experienceYears       Int?
  bioSummary            String?
  latitude              Float?
  longitude             Float?
  phone                 String?
  telegramHandle        String?
  telegramChatId        String?   @unique
  subscriptionTier      String    @default("FREE") // FREE | CARE_PLUS | CARE_FAMILY | DOCTOR_PRO | DOCTOR_CLINIC
  subscriptionStatus    String    @default("NONE") // NONE | ACTIVE | EXPIRED
  subscriptionExpiresAt DateTime?
  scheduleSlotsJson     String    @default("[]")
  createdAt             DateTime  @default(now())

  patientProfile       Patient?             @relation("PatientAccount")
  assignedPatients     Patient[]            @relation("FamilyDoctorPatients")
  authoredEhrs         EhrRecord[]          @relation("EhrAuthor")
  orderedLabs          LabReport[]          @relation("LabOrderer")
  writtenPrescriptions Prescription[]       @relation("PrescriptionAuthor")
  dischargedCalls      ActiveCall[]         @relation("DischargingDoctor")
  assignedCalls        ActiveCall[]         @relation("AssignedFamilyDoctor")
  assignedComplaints   Complaint[]          @relation("ComplaintDoctor")
  subscriptions        SubscriptionRecord[]

  @@map("users")
}

model Patient {
  id                     String    @id @default(cuid())
  userId                 String?   @unique
  user                   User?     @relation("PatientAccount", fields: [userId], references: [id])
  fullName               String
  jshshirEncrypted       String
  jshshirMasked          String
  dateOfBirth            String
  phone                  String
  district               String
  mahalla                String
  address                String
  latitude               Float?
  longitude              Float?
  telegramChatId         String?
  bloodType              String
  allergiesJson          String    @default("[]")
  polyclinicId           String
  polyclinicName         String
  assignedFamilyDoctorId String?
  assignedFamilyDoctor   User?     @relation("FamilyDoctorPatients", fields: [assignedFamilyDoctorId], references: [id])
  emergencyContact       String
  status                 String    @default("INPATIENT") // INPATIENT | PATRONAGE_ACTIVE | VISIT_COMPLETED | PENDING_VERIFICATION | REJECTED
  bedNumber              String?
  subscriptionTier       String    @default("FREE")
  subscriptionStatus     String    @default("NONE")
  subscriptionExpiresAt  DateTime?
  admittedAt             DateTime  @default(now())
  dischargedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  ehrRecords     EhrRecord[]
  labReports     LabReport[]
  prescriptions  Prescription[]
  activeCalls    ActiveCall[]
  invoices       Invoice[]
  complaints     Complaint[]
  directMessages DirectMessage[]

  @@map("patients")
}

model EhrRecord {
  id                     String   @id @default(cuid())
  patientId              String
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId               String
  author                 User     @relation("EhrAuthor", fields: [authorId], references: [id])
  recordType             String   // INPATIENT_SUMMARY | DISCHARGE_EPIKRIZ | POST_DISCHARGE_VITALS
  diagnosisIcd10         String
  diagnosisText          String
  severity               String   // SEVERE | HIGH_RISK | MODERATE
  clinicalNotesEncrypted String
  vitalsJson             String
  proceduresJson         String   @default("[]")
  dischargeDocumentKey   String?
  createdAt              DateTime @default(now())

  @@map("ehr_records")
}

model LabReport {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderedById   String
  orderedBy     User     @relation("LabOrderer", fields: [orderedById], references: [id])
  panelName     String
  status        String   @default("COMPLETED") // COMPLETED | ORDERED_FOLLOWUP
  resultsJson   String
  attachmentKey String?
  reportedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("lab_reports")
}

model Prescription {
  id                  String   @id @default(cuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedById      String
  prescribedBy        User     @relation("PrescriptionAuthor", fields: [prescribedById], references: [id])
  medicationName      String
  dosage              String
  frequency           String
  durationDays        Int
  instructionsUz      String
  instructionsRu      String
  instructionsEn      String
  pharmacyStockStatus String   @default("IN_STOCK") // IN_STOCK | LOW_STOCK | RESERVED
  polyclinicPharmacy  String
  adherenceLogsJson   String   @default("[]")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@map("prescriptions")
}

model ActiveCall {
  id                   String    @id @default(cuid())
  patientId            String
  patient              Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dischargedById       String
  dischargedBy         User      @relation("DischargingDoctor", fields: [dischargedById], references: [id])
  assignedDoctorId     String
  assignedDoctor       User      @relation("AssignedFamilyDoctor", fields: [assignedDoctorId], references: [id])
  polyclinicName       String
  district             String
  status               String    @default("SCHEDULED") // SCHEDULED | ESCALATED_12H | CRITICAL_18H | COMPLETED
  priority             String    @default("HIGH") // NORMAL | HIGH | CRITICAL
  riskScore            Int
  redFlagsJson         String
  checklistJson        String
  patientGuideJson     String
  scheduledWindowStart DateTime
  scheduledWindowEnd   DateTime
  dischargedAt         DateTime
  slaDeadlineAt        DateTime
  escalationLevel      Int       @default(0) // 0: Green (<12h), 1: Yellow (12-18h), 2: Red (>18h)
  symptomCheckinsJson  String    @default("[]")
  doctorVitalsJson     String?
  visitNotes           String?
  patientOtpCode       String
  visitVerifiedAt      DateTime?
  verificationMethod   String?   // OTP_4DIGIT | ONE_TAP_PORTAL
  aiAgentTraceJson     String    @default("[]")
  notificationLogJson  String    @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  invoices Invoice[]

  @@map("active_calls")
}

model Invoice {
  id                String     @id @default(cuid())
  patientId         String
  patient           Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  activeCallId      String
  activeCall        ActiveCall @relation(fields: [activeCallId], references: [id], onDelete: Cascade)
  itemCode          String
  description       String
  category          String     // STATE_GRANT | PAID_DIAGNOSTIC
  amountUzs         Int
  stateCoveredUzs   Int
  patientPayableUzs Int
  packageName       String
  status            String     @default("COVERED_BY_STATE") // COVERED_BY_STATE | PAID | PENDING
  createdAt         DateTime   @default(now())

  @@map("invoices")
}

model Complaint {
  id                    String    @id @default(cuid())
  patientId             String
  patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignedDoctorId      String?
  assignedDoctor        User?     @relation("ComplaintDoctor", fields: [assignedDoctorId], references: [id])
  title                 String
  description           String
  category              String    @default("POSTPARTUM") // POSTPARTUM | CARDIO | PEDIATRIC | GENERAL | EMERGENCY | OTHER
  severity              String    @default("MODERATE") // MILD | MODERATE | SEVERE | CRITICAL
  status                String    @default("SUBMITTED") // SUBMITTED | DOCTOR_RESPONDED | EN_ROUTE | ARRIVED | VERIFIED_COMPLETED
  visitDestination      String    @default("HOME") // HOME | CURRENT_GPS | RELATIVE_HOME | CLINIC | CUSTOM
  visitAddress          String
  latitude              Float?
  longitude             Float?
  distanceKm            Float?
  preferredTimeWindow   String?
  sourceChannel         String    @default("WEB") // WEB | TELEGRAM
  doctorResponse        String?
  doctorRespondedAt     DateTime?
  visitOtpCode          String
  visitVerifiedAt       DateTime?
  visitVerificationNote String?
  verifiedVitalsJson    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  messages DirectMessage[]

  @@map("complaints")
}

model DirectMessage {
  id              String     @id @default(cuid())
  complaintId     String?
  complaint       Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  patientId       String
  patient         Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  senderUserId    String
  senderName      String
  senderRole      String     // PATIENT | FAMILY_MD | OVABMU_MD | ADMIN_RECEPTION
  recipientUserId String?
  body            String
  channel         String     @default("WEB") // WEB | TELEGRAM
  createdAt       DateTime   @default(now())

  @@map("direct_messages")
}

model SubscriptionRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole    String   // PATIENT | DOCTOR
  planCode      String   // CARE_PLUS | CARE_FAMILY | DOCTOR_PRO | DOCTOR_CLINIC
  planName      String
  priceUzs      Int
  paymentMethod String   @default("PAYME") // PAYME | CLICK | UZCARD | HUMO
  status        String   @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  startsAt      DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@map("subscriptions")
}

model TelegramSession {
  chatId            String   @id
  telegramUsername  String?
  telegramFirstName String?
  userId            String?
  flowState         String   @default("IDLE")
  draftJson         String   @default("{}")
  historyJson       String   @default("[]")
  updatedAt         DateTime @updatedAt

  @@map("telegram_sessions")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actorName    String
  actorRole    String
  action       String
  resourceType String
  resourceId   String
  ipAddress    String
  detailsJson  String
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

model SystemSimState {
  id                  String   @id @default("singleton")
  timeOffsetHours     Int      @default(0)
  cleanSlateVersion   Int      @default(0)
  telegramBotTokenEnc String?
  telegramBotUsername String?
  updatedAt           DateTime @updatedAt

  @@map("system_sim_state")
}
